@baseUrl = http://localhost:3000/api/v1

### Registro de usuario
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "name": "User Name",
  "password": "password123"
}

### Login de usuario
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password123"
}
