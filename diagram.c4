C4Component
    title Diagrama de Componentes - Módulos del Monolito (Node.js/TypeScript)

    Container_Boundary(monolith_core, "TicketWave API Application") {
        Component(catalog, "Catalog Module", "TS Module", "Búsqueda de eventos, fechas y venues.")
        Component(ticketing, "Ticketing Module", "TS Module", "Reserva de asientos, control de duplicados y emisión.")
        Component(payment, "Payment Module", "TS Module", "Gestión de transacciones y reembolsos.")
        Component(fraud, "Fraud Module", "TS Module", "Analiza comportamiento de compra y frena bots.")
        Component(promo, "Promotion Module", "TS Module", "Aplica descuentos nacionales y locales.")
        Component(notif, "Notification Module", "TS Module", "Escucha eventos de dominio y notifica.")
        Component(users, "Users Module", "TS Module", "Gestión de usuarios y perfiles.")
        Component(auth, "Auth Module", "TS Module", "Autenticación y autorización.")
        
        Component(eventBus, "In-Memory Event Bus", "TypeScript Event Emitter", "Permite la comunicación asíncrona desacoplada entre módulos.")
    }

    Rel(ticketing, catalog, "Consulta disponibilidad en", "Internal Call")
    Rel(ticketing, fraud, "Valida riesgo de compra con", "Internal Call")
    Rel(ticketing, promo, "Calcula precios y descuentos con", "Internal Call")
    Rel(ticketing, payment, "Inicia pago mediante", "Internal Call")
    
    Rel(ticketing, eventBus, "Publica 'OrderCreated', 'TicketPurchased'", "Memory")
    Rel(payment, eventBus, "Publica 'PaymentProcessed'", "Memory")
    Rel(eventBus, ticketing, "Confirma orden tras 'PaymentProcessed'", "Async Event")
    Rel(eventBus, notif, "Notifica tras 'TicketPurchased'", "Async Event")
